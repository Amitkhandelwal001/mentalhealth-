## 6. Database Schema Design

### 6.1 Collections Overview

#### Users Collection
```javascript
{
  _id: ObjectId,
  username: String, // unique, 3-20 characters
  email: String, // unique, validated
  passwordHash: String, // bcrypt hashed
  profile: {
    displayName: String, // can be anonymous
    avatar: String, // default emoji
    joinDate: Date,
    timezone: String
  },
  preferences: {
    notifications: Boolean,
    publicProfile: Boolean, // for community features
    reminderTime: String // for daily check-ins
  },
  stats: {
    totalCheckIns: Number,
    currentStreak: Number,
    longestStreak: Number,
    points: Number,
    level: Number
  },
  createdAt: Date,
  updatedAt: Date
}
```

#### MoodEntries Collection
```javascript
{
  _id: ObjectId,
  userId: ObjectId, // reference to Users
  moodScore: Number, // 1-5 scale
  moodEmoji: String, // 😢😕😐🙂😊
  notes: String, // optional user notes
  tags: [String], // ["work", "family", "health"]
  timeOfDay: String, // "morning", "afternoon", "evening"
  date: Date, // date without time for daily aggregation
  createdAt: Date
}
```

#### Activities Collection
```javascript
{
  _id: ObjectId,
  name: String, // "Deep Breathing Exercise"
  category: String, // "breathing", "journaling", "physical"
  description: String,
  instructions: [String], // step-by-step guide
  duration: Number, // in minutes
  difficultyLevel: String, // "beginner", "intermediate", "advanced"
  tags: [String], // for recommendation matching
  isActive: Boolean
}
```

#### UserActivities Collection (Tracking)
```javascript
{
  _id: ObjectId,
  userId: ObjectId,
  activityId: ObjectId,
  completedAt: Date,
  rating: Number, // 1-5, how helpful was this?
  notes: String, // optional feedback
  duration: Number // actual time spent
}
```

#### CommunityPosts Collection
```javascript
{
  _id: ObjectId,
  authorId: ObjectId, // but displayed anonymously
  title: String,
  content: String,
  category: String, // "support", "celebration", "question"
  tags: [String],
  isAnonymous: Boolean, // always true for privacy
  likes: Number,
  commentCount: Number,
  isModerated: Boolean,
  createdAt: Date,
  updatedAt: Date
}
```

#### Comments Collection
```javascript
{
  _id: ObjectId,
  postId: ObjectId,
  authorId: ObjectId,
  content: String,
  likes: Number,
  isModerated: Boolean,
  createdAt: Date
}
```

